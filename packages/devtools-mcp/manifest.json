{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "evolution-devtools-mcp",
  "version": "0.1.0",
  "description": "Token-efficient Evolution SDK repository context for AI coding agents.",
  "author": {
    "name": "DaJo-Code"
  },
  "server": {
    "type": "node",
    "entry_point": "server/bin.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/bin.js"],
      "env": {
        "EVOLUTION_SDK_ROOT": "${user_config.evolutionSdkRoot}"
      }
    }
  },
  "user_config": {
    "evolutionSdkRoot": {
      "type": "directory",
      "title": "Evolution SDK repository root",
      "description": "Directory containing the Evolution SDK root package.json and packages/evolution/package.json.",
      "default": "${HOME}/evolution-sdk",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin", "linux", "win32"]
  }
}
